{
  "name": "agenthub-feedback",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "triggers": { "crons": ["15 19 * * *"] },
  "vars": {
    // Comma-separated site origins that may vote, count discussion opens and report searches: the site in
    // site.mjs, and the old address, whose pages readers may still have open.
    "ALLOWED_ORIGIN": "https://agent-hub-community.github.io,https://hqhq1025.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agenthub-feedback",
      "database_id": "b9bfa9b1-375c-4fc7-a527-be32949a9809"
    }
  ],
  "ratelimits": [
    {
      "name": "READ_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Query embeddings for /content/search (feedback/semantic-search.mjs). Free plan: 10,000 neurons a day, about
  // 0.04 per query; past that the call fails and the search answers with BM25 and query.semantic "unavailable".
  "ai": { "binding": "AI" },
  "observability": { "enabled": false }
}
